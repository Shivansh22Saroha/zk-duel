# Leave VITE_API_URL / VITE_WS_URL empty to use the host the page was loaded from
# (http://<that-host>:8080 and ws://<that-host>:8080/ws) — this makes LAN play work without edits.
VITE_API_URL=
VITE_WS_URL=
VITE_ZK_BASE=/zk
VITE_DEV_CHEATS=true
VITE_SHOW_DEBUG=true
# Dev only: keep this player's per-tick log (public + private) in memory and offer a
# "Download tick log" button on the results screen. Never sent to the server.
VITE_LOG_TICKS=true
