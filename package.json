{
  "name": "zk-duel",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "1v1 browser shooter with zero-knowledge rule-compliance proofs (CSC301 seminar prototype)",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "shared",
    "client",
    "server",
    "circuits",
    "bench"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit --project circuits",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:circuits": "vitest run --project circuits",
    "test:int": "vitest run --project integration",
    "test:e2e": "npm run e2e:cheats && npm run e2e:audit-reload",
    "circuits:ptau": "npm run ptau --workspace circuits --",
    "circuits:build": "npm run build -w circuits --",
    "circuits:check": "npm run check --workspace circuits",
    "db:migrate": "npm run db:migrate -w server",
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:lan": "concurrently -k -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client -- --host\"",
    "perf:frame": "tsx client/scripts/perf-frame.ts",
    "bots": "npm run bots -w server --",
    "circuits:prove-log": "npm run prove-log -w circuits --",
    "circuits:mutate-log": "npm run mutate-log -w circuits --",
    "circuits:lint": "npm run lint -w circuits",
    "perf:prove": "tsx client/scripts/perf-prove.ts",
    "perf:match": "tsx client/scripts/perf-match.ts",
    "perf:serve": "npm run build:perf -w client && concurrently -k -n server,client -c blue,magenta \"npm run start -w server\" \"npm run preview -w client\"",
    "e2e:audit-reload": "tsx client/scripts/e2e-audit-reload.ts",
    "exp:detect": "tsx server/scripts/exp-detect.ts",
    "e2e:cheats": "tsx client/scripts/e2e-cheats.ts",
    "exp:browser": "tsx client/scripts/exp-browser.ts",
    "bench:node": "tsx bench/run.ts",
    "bench:browser": "tsx client/scripts/bench-browser.ts",
    "screenshots": "tsx client/scripts/screenshots.ts",
    "bench:export": "tsx bench/export.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "ws": "8.22.0",
    "underscore": "1.13.8"
  }
}
